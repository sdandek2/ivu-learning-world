{
  "name": "ivu-learning-world",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IVU Learning World — a local-first learning universe for young learners",
  "scripts": {
    "dev": "vite",
    "build:curriculum": "node scripts/build-curriculum.ts",
    "validate": "node scripts/build-curriculum.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run build:curriculum && tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node scripts/e2e-smoke.mjs",
    "import:ivu-reads": "node scripts/import-ivu-reads.mjs",
    "audit:curriculum": "node scripts/audit-curriculum-quality.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.1.1",
    "@fontsource-variable/nunito": "^5.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource/andika": "^5.3.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
