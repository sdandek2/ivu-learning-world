# Copy to .env.local (git-ignored) and fill in. Used by `npm run narration:render -- --engine elevenlabs`.
ELEVENLABS_API_KEY=
# The IVU Reads voice. Find it with: npm run narration:render -- --engine elevenlabs --list-voices
ELEVENLABS_VOICE_ID=
# Use the same model IVU Reads was made with if you know it (e.g. eleven_multilingual_v2, eleven_turbo_v2_5, eleven_flash_v2_5).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
